{
  "manifest_version": 3,
  "name": "Earful Bridge",
  "short_name": "Earful",
  "version": "0.2.0",
  "description": "Shows every browser tab that plays media as its own player in the Earful GNOME extension. Nothing leaves your computer.",
  "homepage_url": "https://github.com/NGdev2/earful",
  "browser_specific_settings": {
    "gecko": {
      "id": "earful@ngdev2.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/relay.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
